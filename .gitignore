# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# ----------
# nuucast

nuucast/media/*
nuucast/temp_files/*

nuucast/frontend/js/**/*.js

nuucast/frontend/node_modules

nuucast/static/js/*
nuucast/static/css/*
nuucast/static/img/*

# ----------
# nuuwatch
nuuwatch/data/*
nuuwatch/downloads/*
nuuwatch/.env

nuuwatch/frontend/**/*.css
nuuwatch/frontend/**/*.css.map

nuuwatch/static/js/*
nuuwatch/static/css/*
nuuwatch/static/modules/*
nuuwatch/static/img/*
nuuwatch/frontend/node_modules
nuuwatch/frontend/js/**/*.js
nuuwatch/frontend/modules/**/*.js
nuuwatch/frontend/modules/local

nuuwatch/src/modules/anime/other

# -----------
# nuufetch

nuufetch

# ------------
# deploy scripts

deploy/rsync/rsync-variables.sh
